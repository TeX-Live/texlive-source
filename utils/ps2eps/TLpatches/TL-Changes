Changes applied to the ps2eps-1.72 tree as obtained from:
	https://github.com/roland-bless/ps2eps

# update ../README (== Build/source/utils/README) for version and url.
# update version in ./configure.ac.
tar tf ps2eps-1*.tar.gz | sed 4q # check that it unpacks into ps2eps-*
tar xf ps2eps-1*.tar.gz
mv ps2eps-src prev
mv ps2eps-1* ps2eps-src
cd ps2eps-src
mv src/perl/ps2eps{,.pl} # because script_links.am requires an extension.

# files to add:
svn status | sed -n 's/^\?//p'
svn add `!!`                    # if looks reasonable
svn status | sed -n 's/^\?//p'  # rerun, should be empty now
#
# files to remove:
svn status | sed -n 's/^\!//p'
svn rm `!!`                     # if looks reasonable
svn status | sed -n 's/^\!//p'  # rerun, should be empty now
#
svn status # should have no ? or !

# update our own ./Makefile.am here, as needed.

# autoreconf in the TL source directory (Build/source/utils/ps2eps),
# then make, make check, make install, etc., in build directory.

# for ps2eps[.pl], might as well update runtime files by hand,
# since it's just a script. Use your own Master path.
Master=/u/texlive/karl/Master
cp -p ps2eps-src/src/perl/ps2eps.pl $Master/texmf-dist/scripts/ps2eps/ps2eps.pl
cp -p ps2eps-src/doc/man/man1/ps2eps.1 $Master/texmf-dist/doc/man/man1/ps2eps.1

# commit:
svn commit -m"ps2eps-$newver" ../README . $Master/texmf-dist/{scripts,doc}
